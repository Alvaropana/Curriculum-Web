---
const { json } = Astro.props;
---

<article class="tarjeta">
    <img src={json.imagen} alt={json.centro} />
    <div class="contenido">
        <h3>{json.titulo}</h3>
        <p>{json.fecha}</p>
    </div>
</article>

<style>
    .tarjeta {
        display: grid;
        grid-template-columns: minmax(90px, 1fr) 2fr;
        align-items: center;
        gap: 1.5rem;
        padding: 0.9rem 1.5rem;
        background: var(--superficie);
        border-radius: 8px;
        box-shadow: var(--sombra);
    }
    img {
        justify-self: center;
        width: 100%;
        max-width: 120px;
        height: auto;
        object-fit: contain;
    }
    h3 {
        margin: 0 0 0.25rem;
        font-size: 1.15rem;
        font-weight: 700;
    }
    p {
        margin: 0;
        font-size: 1.1rem;
        color: var(--texto-suave);
    }

    @media (max-width: 520px) {
        .tarjeta {
            grid-template-columns: 1fr;
            text-align: center;
        }
    }
</style>