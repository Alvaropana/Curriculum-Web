---
interface Contacto {
    tipo: string;
    texto?: string;
    icono: string;
}

interface Props {
    contacto: Contacto[];
}

const { contacto } = Astro.props;
---

<footer id="contacto" class="pie">
    <ul>
        {
            contacto.map((dato) => (
                <li>
                    <img src={dato.icono} alt="" />
                    <span>{dato.texto ?? dato.tipo}</span>
                </li>
            ))
        }
    </ul>
</footer>

<style>
    .pie {
        margin-top: 5rem;
        padding: 3rem 0;
        background: var(--acento-pie);
    }
    ul {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem 1.5rem;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
        list-style: none;
    }
    li {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 3rem;
        margin-left: 2.4rem;
        background: var(--acento-pildora);
        border-radius: 6px;
    }
    img {
        position: absolute;
        left: -2.4rem;
        top: 50%;
        transform: translateY(-50%);
        width: 4.8rem;
        height: 4.8rem;
        padding: 1.4rem;
        object-fit: contain;
        background: var(--acento-pildora);
        border-radius: 50%;
        box-shadow: var(--sombra);
    }
    span {
        flex: 1;
        padding: 0.5rem 0.5rem 0.5rem 2.6rem;
        text-align: center;
        font-size: 0.75rem;
        line-height: 1.3;
        color: var(--texto);
        overflow-wrap: break-word;
    }

    @media (min-width: 1240px) {
    ul {
        grid-template-columns: repeat(4, 1fr);
    }

    
    li:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 100%;
            top: 50%;
            transform: translateY(-50%);
            width: calc(1.5rem + 2.4rem);
            height: 1.6rem;
            background: var(--acento-pildora);
        }
    }

    @media (max-width: 600px) {
        ul {
            grid-template-columns: 1fr;
        }
    }
</style>